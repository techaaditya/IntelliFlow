# IntelliFlow Engine 3 (Agents) — copy to `.env` and fill in your key.
# The `.env` file is gitignored; never commit real secrets.
#
# The agent crew's LLM backbone is any OpenAI-compatible endpoint. The default
# is Ollama Cloud (https://ollama.com) serving gpt-oss:120b. Create a key at
# https://ollama.com/settings/keys.

OLLAMA_API_KEY=your_ollama_cloud_api_key_here
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Optional tuning (also configurable in config.yaml under `agents:`)
# OLLAMA_TEMPERATURE=0.2
# AGENT_MAX_STEPS=8
# AGENT_MAX_MEMORY_RESULTS=5
# OLLAMA_TIMEOUT=120
